<?xml version="1.0" encoding="UTF-8"?>
<Container version="2">
  <Name>RunningWithRifles</Name>
  <Beta>False</Beta>
  <Category>GameServers:</Category>
  <Date>2026-08-26</Date>
  <Repository>ghcr.io/skullrider0/rwr-unraid:latest</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/skullrider0/RWR-Unraid/issues</Support>
  <Project>https://runningwithrifles.com/</Project>
  <Overview>Running With Rifles dedicated server for Unraid. Uses SteamCMD to install/update AppID 270150 and keeps server data persistent.</Overview>
  <WebUI></WebUI>
  <TemplateURL>https://raw.githubusercontent.com/skullrider0/RWR-Unraid/main/templates/RunningWithRifles.xml</TemplateURL>
  <Shell>bash</Shell>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <Config Name="Server Data" Target="/serverdata" Default="/mnt/user/appdata/rwr-server" Mode="rw" Description="Persistent RWR and SteamCMD data." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/rwr-server</Config>
  <Config Name="Steam Username" Target="STEAM_USER" Default="" Mode="" Description="Steam account username. Use a dedicated Steam account that owns RWR." Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Steam Password" Target="STEAM_PASS" Default="" Mode="" Description="Steam account password." Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Update On Start" Target="UPDATE_ON_START" Default="false" Mode="" Description="Set true to update RWR through SteamCMD before starting." Type="Variable" Display="always" Required="true" Mask="false">false</Config>
  <Config Name="RWR TCP Port" Target="1238" Default="1238" Mode="tcp" Description="RWR server TCP port." Type="Port" Display="always" Required="true" Mask="false">1238</Config>
  <Config Name="RWR UDP Port" Target="1238" Default="1238" Mode="udp" Description="RWR server UDP port." Type="Port" Display="always" Required="true" Mask="false">1238</Config>
</Container>
